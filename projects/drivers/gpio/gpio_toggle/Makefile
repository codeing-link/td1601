$(ELF): $(OBJS)
	@mkdir -p $(LST)
	$(CC) $(OBJS) -Wl,--start-group -lm -Wl,--end-group $(LDFLAGS) -o $@
	$(OBJDUMP) -d $@ > $(LST)/$(PROJECT).asm
$(BIN): $(ELF)
	$(OBJCOPY) -O binary $< $@
$(IHEX): $(ELF)
	$(OBJCOPY) -O ihex $< $@
size: $(ELF)
	$(SIZE) $(ELF)
clean:
	rm -rf $(OBJ) $(LST)
-include $(DEPS)
